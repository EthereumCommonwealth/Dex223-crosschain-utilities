# Copy to snapshot/.env (gitignored) and fill in. Never commit real values.

# RPC for the chain being read (snapshot.py) or sent on (send.py takes it as --rpc).
# Provider URLs usually embed an API key.
RPC_URL=

# Token to snapshot. Defaults to D223 on Ethereum.
TOKEN_ADDRESS=0x0908078Da2935A14BC7a17770292818C85b580dd

# send.py only: the key of the wallet holding the tokens to distribute.
PRIVATE_KEY=
